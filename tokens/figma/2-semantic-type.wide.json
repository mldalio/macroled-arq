{
  "$extensions": {
    "com.figma": {
      "collection": "2 · Semantic · Type",
      "mode": "Wide"
    }
  },
  "type": {
    "display": {
      "size": {
        "$type": "number",
        "$value": "{font.size.64}",
        "$description": "Tamaño del estilo role/display. Lo usa el estilo de texto: no aplicar directo.",
        "$extensions": {
          "com.figma": {
            "scopes": [
              "FONT_SIZE"
            ],
            "codeSyntax": {
              "WEB": "var(--arq-type-display-size)"
            }
          }
        }
      },
      "leading": {
        "$type": "number",
        "$value": "{font.leading.72}",
        "$description": "Interlineado del estilo role/display. Lo usa el estilo de texto: no aplicar directo.",
        "$extensions": {
          "com.figma": {
            "scopes": [
