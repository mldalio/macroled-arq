{
  "$extensions": {
    "com.figma": {
      "collection": "2 · Semantic · Motion",
      "mode": "Value"
    }
  },
  "motion": {
    "duration": {
      "fast": {
        "$type": "number",
        "$value": 120,
        "$description": "Hover, toggle, foco. En ms. Con prefers-reduced-motion: 0.",
        "$extensions": {
          "com.figma": {
            "scopes": [],
            "codeSyntax": {
              "WEB": "var(--arq-motion-duration-fast)"
            }
          }
        }
      },
      "base": {
        "$type": "number",
        "$value": 200,
        "$description": "Desplegables (disclosure) y menús. En ms. Con prefers-reduced-motion: 0.",
        "$extensions": {
          "com.figma": {
            "scopes": [],
            "codeSyntax": {
              "WEB": "var(--arq-motion-duration-base)"
            }
          }
        }
      },
      "slow": {
        "$type": "number",
        "$value": 320,
        "$description": "Fundido de imágenes de product-card y mensaje de form-message al aparecer. En ms. Con prefers-reduced-motion: 0.",
        "$extensions": {
          "com.figma": {
            "scopes": [],
            "codeSyntax": {
              "WEB": "var(--arq-motion-duration-slow)"
            }
          }
        }
      },
      "feedback": {
        "$type": "number",
        "$value": 2000,
        "$description": "Tiempo visible de una confirmación (Copiado del sku). En ms. No cambia con prefers-reduced-motion.",
        "$extensions": {
          "com.figma": {
            "scopes": [],
            "codeSyntax": {
              "WEB": "var(--arq-motion-duration-feedback)"
            }
          }
        }
      },
      "expand": {
        "$type": "number",
        "$value": 250,
        "$description": "Alto de un desplegable que se abre o se cierra (faq-item). En ms. Con prefers-reduced-motion: 0.",
        "$extensions": {
          "com.figma": {
            "scopes": [],
            "codeSyntax": {
              "WEB": "var(--arq-motion-duration-expand)"
            }
          }
        }
      },
      "fade": {
        "$type": "number",
        "$value": 150,
        "$description": "Fundido corto de algo que aparece (menú de input Select, error de input). En ms. No cambia con prefers-reduced-motion: es el fundido que queda.",
        "$extensions": {
          "com.figma": {
            "scopes": [],
            "codeSyntax": {
              "WEB": "var(--arq-motion-duration-fade)"
            }
          }
        }
      },
      "panel": {
        "$type": "number",
        "$value": 400,
        "$description": "Entrada y salida de paneles y menús que se abren por encima (filter-panel, download-modal, search-sheet, mega-menú). En ms. Con prefers-reduced-motion: 0 (queda el fundido de motion/duration/fade).",
        "$extensions": {
          "com.figma": {
            "scopes": [],
            "codeSyntax": {
              "WEB": "var(--arq-motion-duration-panel)"
            }
          }
        }
      }
    },
    "easing": {
      "standard": {
        "$type": "string",
        "$value": "cubic-bezier(0.2, 0, 0, 1)",
        "$description": "Cambios de estado: hover, foco, selección, paneles y fundidos de imagen. Para entradas, motion/easing/out.",
        "$extensions": {
          "com.figma": {
            "scopes": [],
            "codeSyntax": {
              "WEB": "var(--arq-motion-easing-standard)"
            }
          }
        }
      },
      "out": {
        "$type": "string",
        "$value": "cubic-bezier(0.23, 1, 0.32, 1)",
        "$description": "Entradas: algo que aparece o se despliega (arranca rápido y frena suave).",
        "$extensions": {
          "com.figma": {
            "scopes": [],
            "codeSyntax": {
              "WEB": "var(--arq-motion-easing-out)"
            }
          }
        }
      }
    }
  }
}
