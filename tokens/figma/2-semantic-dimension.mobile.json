{
  "$extensions": {
    "com.figma": {
      "collection": "2 · Semantic · Dimension",
      "mode": "Mobile"
    }
  },
  "layout": {
    "gutter": {
      "$type": "number",
      "$value": "{space.20}",
      "$description": "Margen lateral de la página.",
      "$extensions": {
        "com.figma": {
          "scopes": [
            "WIDTH_HEIGHT",
            "GAP"
          ],
          "codeSyntax": {
            "WEB": "var(--arq-layout-gutter)"
          }
        }
      }
    },
    "card-min": {
      "$type": "number",
      "$value": 160,
      "$description": "Ancho mínimo de tarjeta en la grilla de catálogo (auto-fill). Desde 1600 px se reemplaza por layout/card-min-wide con una media query.",
      "$extensions": {
        "com.figma": {
          "scopes": [
            "WIDTH_HEIGHT"
          ],
          "codeSyntax": {
            "WEB": "var(--arq-layout-card-min)"
          }
        }
      }
    },
    "compare-media-max": {
      "$type": "number",
      "$value": 2000,
      "$description": "Tope de ancho de la foto de compare-product. En la práctica la foto ocupa la columna.",
      "$extensions": {
        "com.figma": {
          "scopes": [
            "WIDTH_HEIGHT"
          ],
          "codeSyntax": {
            "WEB": "var(--arq-layout-compare-media-max)"
          }
        }
      }
    },
    "card-min-wide": {
      "$type": "number",
      "$value": 340,
      "$description": "Ancho mínimo de tarjeta en la grilla de catálogo desde 1600 px. Se aplica en el CSS de la grilla con una media query (min-width: 1600px); no es un modo.",
      "$extensions": {
        "com.figma": {
          "scopes": [
            "WIDTH_HEIGHT"
          ],
          "codeSyntax": {
            "WEB": "var(--arq-layout-card-min-wide)"
          }
        }
      }
    },
    "measure": {
      "$type": "number",
      "$value": 400,
      "$description": "Ancho máximo de un texto de lectura junto a otro elemento (bajada de section-header Description). En Mobile el texto ocupa todo el ancho.",
      "$extensions": {
        "com.figma": {
          "scopes": [
            "WIDTH_HEIGHT"
          ],
          "codeSyntax": {
            "WEB": "var(--arq-layout-measure)"
          }
        }
      }
    },
    "measure-wide": {
      "$type": "number",
      "$value": 520,
      "$description": "Ancho máximo de un texto de lectura en una columna principal (título y bajada de page-header Detail). En Mobile el texto ocupa todo el ancho.",
      "$extensions": {
        "com.figma": {
          "scopes": [
            "WIDTH_HEIGHT"
          ],
          "codeSyntax": {
            "WEB": "var(--arq-layout-measure-wide)"
          }
        }
      }
    },
    "gallery-thumb": {
      "$type": "number",
      "$value": 76,
      "$description": "Ancho de gallery-thumb en product-gallery (105 Desktop · 76 Mobile). El alto sale de ratio/landscape (5:4).",
      "$extensions": {
        "com.figma": {
          "scopes": [
            "WIDTH_HEIGHT"
          ],
          "codeSyntax": {
            "WEB": "var(--arq-layout-gallery-thumb)"
          }
        }
      }
    }
  },
  "space": {
    "section": {
      "2xs": {
        "$type": "number",
        "$value": "{space.24}",
        "$description": "Separación mínima entre bloques de página.",
        "$extensions": {
          "com.figma": {
            "scopes": [
              "GAP"
            ],
            "codeSyntax": {
              "WEB": "var(--arq-space-section-2xs)"
            }
          }
        }
      },
      "xs": {
        "$type": "number",
        "$value": "{space.32}",
        "$description": "Separación ajustada entre bloques de página.",
        "$extensions": {
          "com.figma": {
            "scopes": [
              "GAP"
            ],
            "codeSyntax": {
              "WEB": "var(--arq-space-section-xs)"
            }
          }
        }
      },
      "sm": {
        "$type": "number",
        "$value": "{space.40}",
        "$description": "Separación reducida entre bloques de página.",
        "$extensions": {
          "com.figma": {
            "scopes": [
              "GAP"
            ],
            "codeSyntax": {
              "WEB": "var(--arq-space-section-sm)"
            }
          }
        }
      },
      "md": {
        "$type": "number",
        "$value": "{space.56}",
        "$description": "Separación estándar entre secciones y arriba/abajo de la página.",
        "$extensions": {
          "com.figma": {
            "scopes": [
              "GAP"
            ],
            "codeSyntax": {
              "WEB": "var(--arq-space-section-md)"
            }
          }
        }
      },
      "lg": {
        "$type": "number",
        "$value": "{space.96}",
        "$description": "Separación amplia entre secciones.",
        "$extensions": {
          "com.figma": {
            "scopes": [
              "GAP"
            ],
            "codeSyntax": {
              "WEB": "var(--arq-space-section-lg)"
            }
          }
        }
      },
      "xl": {
        "$type": "number",
        "$value": "{space.128}",
        "$description": "Separación máxima, para secciones destacadas.",
        "$extensions": {
          "com.figma": {
            "scopes": [
              "GAP"
            ],
            "codeSyntax": {
              "WEB": "var(--arq-space-section-xl)"
            }
          }
        }
      }
    },
    "gap": {
      "xs": {
        "$type": "number",
        "$value": "{space.4}",
        "$description": "Elementos muy pegados, como un ícono junto a su texto.",
        "$extensions": {
          "com.figma": {
            "scopes": [
              "GAP"
            ],
            "codeSyntax": {
              "WEB": "var(--arq-space-gap-xs)"
            }
          }
        }
      },
      "sm": {
        "$type": "number",
        "$value": "{space.8}",
        "$description": "Entre título y bajada, o label e input.",
        "$extensions": {
          "com.figma": {
            "scopes": [
              "GAP"
            ],
            "codeSyntax": {
              "WEB": "var(--arq-space-gap-sm)"
            }
          }
        }
      },
      "sm-md": {
        "$type": "number",
        "$value": "{space.12}",
        "$description": "Gap entre sm (8) y md (16): 12 en Desktop y Mobile.",
        "$extensions": {
          "com.figma": {
            "scopes": [
              "GAP"
            ],
            "codeSyntax": {
              "WEB": "var(--arq-space-gap-sm-md)"
            }
          }
        }
      },
      "md": {
        "$type": "number",
        "$value": "{space.16}",
        "$description": "Separación entre elementos de un bloque (título y párrafo, filas de una lista).",
        "$extensions": {
          "com.figma": {
            "scopes": [
              "GAP"
            ],
            "codeSyntax": {
              "WEB": "var(--arq-space-gap-md)"
            }
          }
        }
      },
      "lg": {
        "$type": "number",
        "$value": "{space.20}",
        "$description": "Entre grupos dentro de un bloque.",
        "$extensions": {
          "com.figma": {
            "scopes": [
              "GAP"
            ],
            "codeSyntax": {
              "WEB": "var(--arq-space-gap-lg)"
            }
          }
        }
      },
      "xl": {
        "$type": "number",
        "$value": "{space.24}",
        "$description": "Entre el encabezado de una sección y su contenido, o columnas grandes.",
        "$extensions": {
          "com.figma": {
            "scopes": [
              "GAP"
            ],
            "codeSyntax": {
              "WEB": "var(--arq-space-gap-xl)"
            }
          }
        }
      },
      "xl-2xl": {
        "$type": "number",
        "$value": "{space.32}",
        "$description": "Gap entre xl y 2xl: 40 en Desktop, 32 en Mobile.",
        "$extensions": {
          "com.figma": {
            "scopes": [
              "GAP"
            ],
            "codeSyntax": {
              "WEB": "var(--arq-space-gap-xl-2xl)"
            }
          }
        }
      },
      "2xl": {
        "$type": "number",
        "$value": "{space.40}",
        "$description": "Entre grupos grandes de contenido dentro de una sección.",
        "$extensions": {
          "com.figma": {
            "scopes": [
              "GAP"
            ],
            "codeSyntax": {
              "WEB": "var(--arq-space-gap-2xl)"
            }
          }
        }
      },
      "3xl": {
        "$type": "number",
        "$value": "{space.48}",
        "$description": "Distancia entre elementos grandes dentro de un bloque (64 desktop / 48 mobile).",
        "$extensions": {
          "com.figma": {
            "scopes": [
              "GAP"
            ],
            "codeSyntax": {
              "WEB": "var(--arq-space-gap-3xl)"
            }
          }
        }
      },
      "4xl": {
        "$type": "number",
        "$value": "{space.56}",
        "$description": "Distancia entre elementos grandes dentro de un bloque (80 desktop / 56 mobile).",
        "$extensions": {
          "com.figma": {
            "scopes": [
              "GAP"
            ],
            "codeSyntax": {
              "WEB": "var(--arq-space-gap-4xl)"
            }
          }
        }
      },
      "5xl": {
        "$type": "number",
        "$value": "{space.64}",
        "$description": "Distancia entre elementos grandes dentro de un bloque (96 desktop / 64 mobile).",
        "$extensions": {
          "com.figma": {
            "scopes": [
              "GAP"
            ],
            "codeSyntax": {
              "WEB": "var(--arq-space-gap-5xl)"
            }
          }
        }
      },
      "6xl": {
        "$type": "number",
        "$value": "{space.96}",
        "$description": "Distancia entre elementos grandes dentro de un bloque (128 desktop / 96 mobile).",
        "$extensions": {
          "com.figma": {
            "scopes": [
              "GAP"
            ],
            "codeSyntax": {
              "WEB": "var(--arq-space-gap-6xl)"
            }
          }
        }
      }
    },
    "padding": {
      "2xs": {
        "$type": "number",
        "$value": "{space.3}",
        "$description": "Relleno mínimo de controles muy compactos (track del toggle).",
        "$extensions": {
          "com.figma": {
            "scopes": [
              "GAP"
            ],
            "codeSyntax": {
              "WEB": "var(--arq-space-padding-2xs)"
            }
          }
        }
      },
      "xs": {
        "$type": "number",
        "$value": "{space.4}",
        "$description": "Relleno de badges y chips.",
        "$extensions": {
          "com.figma": {
            "scopes": [
              "GAP"
            ],
            "codeSyntax": {
              "WEB": "var(--arq-space-padding-xs)"
            }
          }
        }
      },
      "sm": {
        "$type": "number",
        "$value": "{space.8}",
        "$description": "Relleno de botones y controles compactos.",
        "$extensions": {
          "com.figma": {
            "scopes": [
              "GAP"
            ],
            "codeSyntax": {
              "WEB": "var(--arq-space-padding-sm)"
            }
          }
        }
      },
      "md": {
        "$type": "number",
        "$value": "{space.16}",
        "$description": "Relleno estándar de tarjetas, inputs y paneles.",
        "$extensions": {
          "com.figma": {
            "scopes": [
              "GAP"
            ],
            "codeSyntax": {
              "WEB": "var(--arq-space-padding-md)"
            }
          }
        }
      },
      "lg": {
        "$type": "number",
        "$value": "{space.20}",
        "$description": "Relleno de tarjetas grandes y side sheets.",
        "$extensions": {
          "com.figma": {
            "scopes": [
              "GAP"
            ],
            "codeSyntax": {
              "WEB": "var(--arq-space-padding-lg)"
            }
          }
        }
      },
      "xl": {
        "$type": "number",
        "$value": "{space.24}",
        "$description": "Relleno de modales y bloques destacados.",
        "$extensions": {
          "com.figma": {
            "scopes": [
              "GAP"
            ],
            "codeSyntax": {
              "WEB": "var(--arq-space-padding-xl)"
            }
          }
        }
      },
      "2xl": {
        "$type": "number",
        "$value": "{space.32}",
        "$description": "Relleno de bloques muy aireados.",
        "$extensions": {
          "com.figma": {
            "scopes": [
              "GAP"
            ],
            "codeSyntax": {
              "WEB": "var(--arq-space-padding-2xl)"
            }
          }
        }
      },
      "sm-md": {
        "$type": "number",
        "$value": "{space.12}",
        "$description": "Padding intermedio entre sm (8) y md (16): 12 en Desktop y Mobile.",
        "$extensions": {
          "com.figma": {
            "scopes": [
              "GAP"
            ],
            "codeSyntax": {
              "WEB": "var(--arq-space-padding-sm-md)"
            }
          }
        }
      },
      "xl-2xl": {
        "$type": "number",
        "$value": "{space.32}",
        "$description": "Padding entre xl y 2xl: 40 en Desktop, 32 en Mobile.",
        "$extensions": {
          "com.figma": {
            "scopes": [
              "GAP"
            ],
            "codeSyntax": {
              "WEB": "var(--arq-space-padding-xl-2xl)"
            }
          }
        }
      },
      "3xl": {
        "$type": "number",
        "$value": "{space.48}",
        "$description": "Padding interno de bloques grandes (64 desktop / 48 mobile).",
        "$extensions": {
          "com.figma": {
            "scopes": [
              "GAP"
            ],
            "codeSyntax": {
              "WEB": "var(--arq-space-padding-3xl)"
            }
          }
        }
      },
      "4xl": {
        "$type": "number",
        "$value": "{space.56}",
        "$description": "Padding interno de bloques grandes (80 desktop / 56 mobile).",
        "$extensions": {
          "com.figma": {
            "scopes": [
              "GAP"
            ],
            "codeSyntax": {
              "WEB": "var(--arq-space-padding-4xl)"
            }
          }
        }
      },
      "5xl": {
        "$type": "number",
        "$value": "{space.64}",
        "$description": "Padding interno de bloques grandes (96 desktop / 64 mobile).",
        "$extensions": {
          "com.figma": {
            "scopes": [
              "GAP"
            ],
            "codeSyntax": {
              "WEB": "var(--arq-space-padding-5xl)"
            }
          }
        }
      },
      "6xl": {
        "$type": "number",
        "$value": "{space.96}",
        "$description": "Padding interno de bloques grandes (128 desktop / 96 mobile).",
        "$extensions": {
          "com.figma": {
            "scopes": [
              "GAP"
            ],
            "codeSyntax": {
              "WEB": "var(--arq-space-padding-6xl)"
            }
          }
        }
      }
    }
  },
  "radius": {
    "control": {
      "$type": "number",
      "$value": "{radius.0}",
      "$description": "Radio de todo el sistema: 0 (esquinas rectas). Siempre 0, salvo que se pida explícitamente otra cosa.",
      "$extensions": {
        "com.figma": {
          "scopes": [
            "CORNER_RADIUS"
          ],
          "codeSyntax": {
            "WEB": "var(--arq-radius-control)"
          }
        }
      }
    },
    "pill": {
      "$type": "number",
      "$value": "{radius.full}",
      "$description": "Esquinas totalmente redondeadas. Solo si el componente lo requiere (hoy, la pista de toggle-switch) o se pide explícitamente. Por defecto no se usa.",
      "$extensions": {
        "com.figma": {
          "scopes": [
            "CORNER_RADIUS"
          ],
          "codeSyntax": {
            "WEB": "var(--arq-radius-pill)"
          }
        }
      }
    }
  },
  "border": {
    "default": {
      "$type": "number",
      "$value": "{border.1}",
      "$description": "Grosor de bordes y divisores.",
      "$extensions": {
        "com.figma": {
          "scopes": [
            "STROKE_FLOAT"
          ],
          "codeSyntax": {
            "WEB": "var(--arq-border-default)"
          }
        }
      }
    },
    "focus": {
      "$type": "number",
      "$value": "{border.1}",
      "$description": "Grosor del anillo de foco.",
      "$extensions": {
        "com.figma": {
          "scopes": [
            "STROKE_FLOAT"
          ],
          "codeSyntax": {
            "WEB": "var(--arq-border-focus)"
          }
        }
      }
    },
    "strong": {
      "$type": "number",
      "$value": "{border.2}",
      "$description": "Grosor de borde marcado (2): hover y selección de muestras.",
      "$extensions": {
        "com.figma": {
          "scopes": [
            "STROKE_FLOAT"
          ],
          "codeSyntax": {
            "WEB": "var(--arq-border-strong)"
          }
        }
      }
    }
  },
  "icon": {
    "sm": {
      "$type": "number",
      "$value": "{space.12}",
      "$description": "Íconos dentro de texto pequeño o chips.",
      "$extensions": {
        "com.figma": {
          "scopes": [
            "WIDTH_HEIGHT"
          ],
          "codeSyntax": {
            "WEB": "var(--arq-icon-sm)"
          }
        }
      }
    },
    "md": {
      "$type": "number",
      "$value": "{space.16}",
      "$description": "Íconos por defecto (botones, navegación).",
      "$extensions": {
        "com.figma": {
          "scopes": [
            "WIDTH_HEIGHT"
          ],
          "codeSyntax": {
            "WEB": "var(--arq-icon-md)"
          }
        }
      }
    },
    "lg": {
      "$type": "number",
      "$value": "{space.24}",
      "$description": "Íconos destacados.",
      "$extensions": {
        "com.figma": {
          "scopes": [
            "WIDTH_HEIGHT"
          ],
          "codeSyntax": {
            "WEB": "var(--arq-icon-lg)"
          }
        }
      }
    },
    "xl": {
      "$type": "number",
      "$value": "{space.24}",
      "$description": "Ícono grande (24): acciones destacadas.",
      "$extensions": {
        "com.figma": {
          "scopes": [
            "WIDTH_HEIGHT"
          ],
          "codeSyntax": {
            "WEB": "var(--arq-icon-xl)"
          }
        }
      }
    },
    "2xl": {
      "$type": "number",
      "$value": "{space.32}",
      "$description": "Ícono extra grande (32): acciones de títulos grandes, como el acordeón de la ficha.",
      "$extensions": {
        "com.figma": {
          "scopes": [
            "WIDTH_HEIGHT"
          ],
          "codeSyntax": {
            "WEB": "var(--arq-icon-2xl)"
          }
        }
      }
    }
  },
  "swatch": {
    "sm": {
      "$type": "number",
      "$value": "{space.16}",
      "$description": "Muestra de acabado chica (16): opciones de menú y celdas de filtro.",
      "$extensions": {
        "com.figma": {
          "scopes": [
            "WIDTH_HEIGHT"
          ],
          "codeSyntax": {
            "WEB": "var(--arq-swatch-sm)"
          }
        }
      }
    },
    "md": {
      "$type": "number",
      "$value": "{space.20}",
      "$description": "Muestra de acabado del selector de muestras (20).",
      "$extensions": {
        "com.figma": {
          "scopes": [
            "WIDTH_HEIGHT"
          ],
          "codeSyntax": {
            "WEB": "var(--arq-swatch-md)"
          }
        }
      }
    },
    "lg": {
      "$type": "number",
      "$value": "{space.24}",
      "$description": "Muestra grande (24): campo select y muestra seleccionada.",
      "$extensions": {
        "com.figma": {
          "scopes": [
            "WIDTH_HEIGHT"
          ],
          "codeSyntax": {
            "WEB": "var(--arq-swatch-lg)"
          }
        }
      }
    }
  },
  "blur": {
    "backdrop": {
      "$type": "number",
      "$value": "{blur.12}",
      "$description": "Desenfoque del fondo detrás de una superficie translúcida (background blur / backdrop-filter). Va junto con color/overlay/translucent.",
      "$extensions": {
        "com.figma": {
          "scopes": [
            "EFFECT_FLOAT"
          ],
          "codeSyntax": {
            "WEB": "var(--arq-blur-backdrop)"
          }
        }
      }
    }
  }
}
