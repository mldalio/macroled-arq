{
  "$extensions": {
    "com.figma": {
      "collection": "2 · Semantic · Dimension",
      "mode": "Tablet"
    }
  },
  "layout": {
    "gutter": {
      "$type": "number",
      "$value": "{space.32}",
      "$description": "Margen lateral de la página. Mobile 20 · Tablet (768–1023) 32 · Desktop (1024–1439) 40 · Large (desde 1440) 64. Desde 1920 el margen crece para que el contenido no pase de layout/max-width; los fondos siguen a todo el ancho.",
      "$extensions": {
        "com.figma": {
          "scopes": [
            "WIDTH_HEIGHT",
            "GAP"
          ],
          "codeSyntax": {
            "WEB": "var(--arq-layout-gutter)"
          }
        }
      }
    },
    "card-min": {
      "$type": "number",
      "$value": 280,
      "$description": "Ancho mínimo de tarjeta en la grilla de catálogo (auto-fill). Desde 1600 px se reemplaza por layout/card-min-wide con una media query.",
      "$extensions": {
        "com.figma": {
          "scopes": [
            "WIDTH_HEIGHT"
          ],
          "codeSyntax": {
            "WEB": "var(--arq-layout-card-min)"
          }
        }
      }
    },
    "compare-media-max": {
      "$type": "number",
      "$value": 2000,
      "$description": "Tope de ancho de la foto de compare-product. En la práctica la foto ocupa la columna.",
      "$extensions": {
        "com.figma": {
          "scopes": [
            "WIDTH_HEIGHT"
          ],
          "codeSyntax": {
            "WEB": "var(--arq-layout-compare-media-max)"
          }
        }
      }
    },
    "card-min-wide": {
      "$type": "number",
      "$value": 340,
      "$description": "Ancho mínimo de tarjeta en la grilla de catálogo desde 1600 px. Se aplica en el CSS de la grilla con una media query (min-width: 1600px); no es un modo.",
      "$extensions": {
        "com.figma": {
          "scopes": [
            "WIDTH_HEIGHT"
          ],
          "codeSyntax": {
            "WEB": "var(--arq-layout-card-min-wide)"
          }
        }
      }
    },
    "measure": {
      "$type": "number",
      "$value": 400,
      "$description": "Ancho máximo de un texto de lectura junto a otro elemento (bajada de section-header Description). En Mobile el texto ocupa todo el ancho.",
      "$extensions": {
        "com.figma": {
          "scopes": [
            "WIDTH_HEIGHT"
          ],
          "codeSyntax": {
            "WEB": "var(--arq-layout-measure)"
          }
        }
      }
    },
    "measure-wide": {
      "$type": "number",
      "$value": 520,
      "$description": "Ancho máximo de un texto de lectura en una columna principal (título y bajada de page-header Detail). En Mobile el texto ocupa todo el ancho.",
      "$extensions": {
        "com.figma": {
          "scopes": [
            "WIDTH_HEIGHT"
          ],
          "codeSyntax": {
            "WEB": "var(--arq-layout-measure-wide)"
          }
        }
      }
    },
    "gallery-thumb": {
      "$type": "number",
      "$value": 105,
      "$description": "Ancho de gallery-thumb en product-gallery (105 Desktop · 76 Mobile). El alto sale de ratio/landscape (5:4).",
      "$extensions": {
        "com.figma": {
          "scopes": [
            "WIDTH_HEIGHT"
          ],
          "codeSyntax": {
            "WEB": "var(--arq-layout-gallery-thumb)"
          }
        }
      }
    },
    "filter-panel": {
      "$type": "number",
      "$value": 560,
      "$description": "Ancho de los paneles en Desktop: filter-panel (lateral sobre el scrim) y download-modal. En Mobile el CSS no usa este valor.",
      "$extensions": {
        "com.figma": {
          "scopes": [
            "WIDTH_HEIGHT"
          ],
          "codeSyntax": {
            "WEB": "var(--arq-layout-filter-panel)"
          }
        }
      }
    },
    "table-thumb": {
      "$type": "number",
      "$value": 56,
      "$description": "Miniatura cuadrada de cada fila de la tabla de variantes (glosario de la ficha).",
      "$extensions": {
        "com.figma": {
          "scopes": [
            "WIDTH_HEIGHT"
          ],
          "codeSyntax": {
            "WEB": "var(--arq-layout-table-thumb)"
          }
        }
      }
    },
    "compare-thumb": {
      "$type": "number",
      "$value": 48,
      "$description": "Foto cuadrada de compare-slot Size=Default (compare-bar y compare-header Compact en Desktop).",
      "$extensions": {
        "com.figma": {
          "scopes": [
            "WIDTH_HEIGHT"
          ],
          "codeSyntax": {
