    "compare-thumb-sm": {
      "$type": "number",
      "$value": 28,
      "$description": "Ancho de compare-slot Size=Compact (miniatura en Mobile). El alto sale de ratio/portrait (7:10).",
      "$extensions": {
        "com.figma": {
          "scopes": [
            "WIDTH_HEIGHT"
          ],
          "codeSyntax": {
            "WEB": "var(--arq-layout-compare-thumb-sm)"
          }
