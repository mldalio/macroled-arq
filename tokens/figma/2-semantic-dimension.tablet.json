    "compare-slot": {
      "$type": "number",
      "$value": 400,
      "$description": "Ancho máximo de compare-slot Size=Default, para que no se estire en pantallas anchas.",
      "$extensions": {
        "com.figma": {
          "scopes": [
            "WIDTH_HEIGHT"
          ],
          "codeSyntax": {
            "WEB": "var(--arq-layout-compare-slot)"
          }
        }
      }
    },
    "compare-label": {
      "$type": "number",
      "$value": 200,
      "$description": "Columna de etiquetas de la comparativa (compare-row, compare-group y la columna de controles de compare-header). En Mobile queda fija al desplazar.",
      "$extensions": {
        "com.figma": {
          "scopes": [
            "WIDTH_HEIGHT"
          ],
          "codeSyntax": {
            "WEB": "var(--arq-layout-compare-label)"
          }
        }
      }
    },
    "compare-column": {
      "$type": "number",
      "$value": 160,
      "$description": "Ancho de cada columna de producto de la comparativa en Mobile (con scroll horizontal). En Desktop las columnas se reparten el ancho.",
      "$extensions": {
        "com.figma": {
          "scopes": [
            "WIDTH_HEIGHT"
          ],
          "codeSyntax": {
            "WEB": "var(--arq-layout-compare-column)"
          }
        }
      }
    },
    "mega-menu-image": {
      "$type": "number",
      "$value": 438,
      "$description": "Ancho de la imagen del mega-menu (a la derecha de las columnas). El alto sale de ratio/portrait-soft (4:5).",
      "$extensions": {
        "com.figma": {
          "scopes": [
            "WIDTH_HEIGHT"
          ],
          "codeSyntax": {
            "WEB": "var(--arq-layout-mega-menu-image)"
          }
        }
      }
    },
    "search-field": {
      "$type": "number",
      "$value": 360,
      "$description": "Ancho de search-field en el navbar Desktop. search-dropdown toma el mismo ancho. En Mobile (search-screen) el campo ocupa el ancho disponible.",
      "$extensions": {
        "com.figma": {
          "scopes": [
            "WIDTH_HEIGHT"
          ],
          "codeSyntax": {
            "WEB": "var(--arq-layout-search-field)"
          }
        }
      }
    },
    "search-thumb": {
      "$type": "number",
      "$value": 48,
      "$description": "Miniatura cuadrada de search-result.",
      "$extensions": {
        "com.figma": {
          "scopes": [
            "WIDTH_HEIGHT"
          ],
          "codeSyntax": {
            "WEB": "var(--arq-layout-search-thumb)"
          }
        }
      }
    },
    "max-width": {
      "$type": "number",
      "$value": 1792,
      "$description": "Ancho máximo del contenido de la página (1920 − 2 × 64). Desde 1920 px el margen lateral es max(layout/gutter, (100% − layout/max-width) / 2). Los fondos, fotos y barras siguen a todo el ancho; solo el contenido se centra. No es un modo.",
      "$extensions": {
        "com.figma": {
          "scopes": [
            "WIDTH_HEIGHT"
          ],
          "codeSyntax": {
            "WEB": "var(--arq-layout-max-width)"
          }
        }
      }
    },
    "select-filter": {
      "$type": "number",
      "$value": 160,
      "$description": "Ancho mínimo de select Type=Filter (celda de filter-bar): la flecha va al extremo derecho de la celda.",
      "$extensions": {
        "com.figma": {
          "scopes": [
            "WIDTH_HEIGHT"
          ],
          "codeSyntax": {
            "WEB": "var(--arq-layout-select-filter)"
          }
        }
      }
    },
    "select-menu-filter": {
      "$type": "number",
      "$value": 200,
      "$description": "Ancho de select-menu Type=Filter (menú de un select Filter).",
      "$extensions": {
        "com.figma": {
          "scopes": [
            "WIDTH_HEIGHT"
          ],
          "codeSyntax": {
            "WEB": "var(--arq-layout-select-menu-filter)"
          }
        }
      }
    }
