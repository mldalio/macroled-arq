# Configuración del equipo: se commitea. Vite la lee con `npm run dev` y con
# `npm run build`, y reemplaza estos valores al compilar: quedan dentro de
# dist/arq.js. Por eso acá va SOLO la search-only key de Typesense (acción
# documents:search, colección macroled_arq únicamente). Es pública por diseño.
# Nunca la admin key. Los cambios personales van en .env.local (ignorado por Git).
# Ver docs/decisiones.md, 2026-10-13 · Datos solo desde Typesense.

VITE_TYPESENSE_HOST=https://typesense.coresagroup.com
VITE_TYPESENSE_COLLECTION=macroled_arq
VITE_TYPESENSE_SEARCH_KEY=fstX8TBuNifh2YewtBqyPEcCxhUQqpkJ

# Webhook de n8n del formulario de contacto (producción). El de prueba va en
# .env.development.local y solo lo usa `npm run dev`.
VITE_N8N_WEBHOOK_URL=https://n8n.coresagroup.com/webhook/ab9b36b1-d92d-469b-bbf5-b29f0546c057
