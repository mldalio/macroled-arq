# Copiar a .env y completar. Nunca commitear .env.
# Vite reemplaza estos valores al compilar: quedan dentro de dist/arq.js.
# Por eso acá va solo la search-only key de Typesense (nunca la admin key).

VITE_TYPESENSE_HOST=
VITE_TYPESENSE_SEARCH_KEY=
VITE_TYPESENSE_COLLECTION=
VITE_N8N_WEBHOOK_URL=

# Fuente de datos en desarrollo: typesense, mixto (Typesense con lo que falta
# completado por demo/fixtures/completar.js) o mock (demo/fixtures/catalogo.json).
# El build siempre usa Typesense.
VITE_DATA_SOURCE=mock
